#  MemorisePDF — every setting, and where each one goes
# ─────────────────────────────────────────────────────────────────────────────
#
#  Not everything below belongs in this file. Each setting is tagged with where
#  it actually lives, because they live in four different places:
#
#   [LOCAL]    Copy this file to .env and set it there. Development only;
#              .env is gitignored and never leaves your machine.
#
#   [SERVER]   Set it in  ~/apps/memorisepdf/.env  on the server. That is the
#              compose project root, which is the one path docker compose reads
#              by itself — which is also what lets `docker compose logs` work
#              there with no extra flags.  chmod 600 it.
#
#   [COMPOSE]  Set for you by deploy/docker-compose.yml. Do NOT put it in the
#              server's .env; it would be ignored or would fight the compose
#              value.
#
#   [GH SECRET]  GitHub → repo Settings → Secrets and variables → Actions
#                → Secrets tab. Write-only: used by the deploy workflow, never
#                readable again afterwards.
#
#   [GH VAR]     GitHub → repo Settings → Secrets and variables → Actions
#                → Variables tab. Plain values, visible in logs. Not secret.
#
#  The GitHub entries are listed here only so one file shows the full picture.
#  Nothing reads them from this file — GitHub Actions reads them directly.
#
#  Full walkthrough: docs/deploy.md


# ══ Core ═════════════════════════════════════════════════════════════════════

# [LOCAL] [COMPOSE]  Port the API listens on. Compose fixes it at 8080 inside
#                    the container, so do not set it on the server.
PORT=8080

# [LOCAL] [SERVER]  "development" or "production". In development the session
#                   cookie is allowed over plain HTTP; anything else requires
#                   HTTPS. Set ENV=production on the server.
ENV=development

# [LOCAL] [SERVER]  Where the API is reachable. Google redirects back to
#                   APP_URL + /auth/google/callback, so on the server this must
#                   be the real public HTTPS address, matching exactly what you
#                   registered with Google.
APP_URL=http://localhost:8080

# [LOCAL] [SERVER]  Where the frontend is reachable. Used for CORS in
#                   development and for the redirect after signing in.
#                   In production this is the same hostname as APP_URL.
WEB_URL=http://localhost:3000

# [LOCAL] [COMPOSE]  Where uploaded lecture files and the log are written.
#                    Compose mounts the server's ./data here, so leave it alone
#                    on the server.
DATA_DIR=./data


# ══ Database ═════════════════════════════════════════════════════════════════
#
# Given as separate parts. The app assembles and escapes the connection string
# itself, so the password may contain any character — and no file in this repo
# ever holds a postgres://user:password@host string.

# [LOCAL] [COMPOSE]  Compose points the API at the db container, so these four
#                    are only for running the API on your own machine against
#                    `make dev-up`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memorisepdf
DB_USER=memorisepdf

# [LOCAL]  The dev database (deploy/docker-compose.dev.yml) uses this fixed
#          password. On the server you set POSTGRES_PASSWORD instead, and the
#          app accepts that as an alternative to this.
DB_PASSWORD=memorisepdf

# [LOCAL] [SERVER]  "disable" is correct for both, because the database is
#                   reached over a private docker network and never the
#                   internet. Use "require" only for an external database.
DB_SSLMODE=disable

# [SERVER]  The one database password you set on the server. Compose creates
#           the Postgres user with it and passes it through to the API, which
#           takes it as an alternative to DB_PASSWORD. Any characters are fine.
#           Generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# [optional, LOCAL or SERVER]  A whole connection string, which overrides every
#   DB_* value above. This is what the tests, CI, and an external managed
#   database use. Leave it unset for the normal setup.
# DATABASE_URL=


# ══ Google sign-in ═══════════════════════════════════════════════════════════
#
# console.cloud.google.com → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
#
# Authorised redirect URI must be exactly APP_URL + /auth/google/callback.
# A mismatch gives "redirect_uri_mismatch" at sign-in rather than a clear error.
#
# Signup is open to any Google account, so also set the OAuth consent screen to
# "In production" — while it is in "Testing" only accounts you list can sign in.

# [LOCAL] [SERVER]  REQUIRED. The app will not start without it.
GOOGLE_CLIENT_ID=

# [LOCAL] [SERVER]  REQUIRED. Treat as a secret: it is as good as a password.
GOOGLE_CLIENT_SECRET=

# [optional, LOCAL or SERVER]  Only needed if the callback is not at
#   APP_URL + /auth/google/callback, which it normally is.
# GOOGLE_REDIRECT_URL=

# [optional, LOCAL or SERVER]  How long a sign-in lasts. Sessions are stored
#   server-side, so signing out revokes immediately regardless of this.
SESSION_TTL=720h

# [optional]  Name of the session cookie. Only worth changing if something else
#   is already serving on the same hostname.
# SESSION_COOKIE=memorisepdf_session

# [optional]  Whether the cookie requires HTTPS. Derived from ENV, so leave it
#   unset — it is true for anything other than ENV=development. Setting it to
#   false in production would send the session cookie in the clear.
# SESSION_SECURE=


# ══ Gemini ═══════════════════════════════════════════════════════════════════

# [LOCAL] [SERVER]  REQUIRED. From aistudio.google.com/apikey
#                   This is the one that costs money if it leaks.
GEMINI_API_KEY=

# [optional, LOCAL or SERVER]  gemini-1.5-flash is switched off; do not go back
#   to it. 3.8-flash is stronger and dearer, 3.5-flash-lite cheaper and weaker.
GEMINI_MODEL=gemini-3.6-flash

# [optional]  Raise it if long lectures come back truncated.
GEMINI_MAX_OUTPUT_TOKENS=32768

# [optional]  Per request to the model. A long lecture genuinely takes minutes.
GEMINI_TIMEOUT=3m


# ══ Text extraction ══════════════════════════════════════════════════════════

# [LOCAL] [COMPOSE]  Compose points the API at the tika container, so this is
#                    only for local use against `make dev-up`.
TIKA_URL=http://localhost:9998

# [optional]  OCR of a scanned deck is slow, so this is deliberately generous.
TIKA_TIMEOUT=2m


# ══ Limits ═══════════════════════════════════════════════════════════════════
#
# Anyone with a Google account can sign up, so these are the only thing between
# a stranger and your disk or your Gemini bill. Set them on the server.

# [LOCAL] [SERVER]  Biggest single upload, in bytes. Default 100 MB.
#   Must stay below the reverse proxy's client_max_body_size, or nginx rejects
#   the upload before the API ever sees it.
MAX_FILE_SIZE=104857600

# [LOCAL] [SERVER]  Total disk one person may use, in bytes. Default 500 MB.
#   Bytes shared between modules are counted once.
USER_STORAGE_QUOTA=524288000

# [LOCAL] [SERVER]  Files one module may hold. Default 50.
MAX_FILES_PER_MODULE=50

# [LOCAL] [SERVER]  Generation requests per person per hour. Default 20.
#   Counts requests, not files — one person with 50 lectures in a module can
#   still cause a lot of work in a single request.
GENERATE_RATE_LIMIT=20

# [optional]  Characters of extracted text sent to the model per file. Longer
#   lectures are truncated at this point.
MAX_EXTRACTED_CHARS=400000


# ══ Logging ══════════════════════════════════════════════════════════════════

# [LOCAL] [SERVER]  debug, info, warn or error.
LOG_LEVEL=info

# [optional]  Log file inside DATA_DIR, so it survives a restart. It rolls at
#   8 MB keeping one previous generation. Set it to empty to log only to stdout.
LOG_FILE=app.log


# ══ Frontend ═════════════════════════════════════════════════════════════════

# [LOCAL only, and in web/.env.local — not this file]
#   Lets `next dev` reach the API on its own port. Next resolves rewrites when
#   it builds, so this cannot be changed at runtime — and does not need to be:
#   in production the reverse proxy routes /api and /auth straight to the API
#   container, and the production image is built without it.
#
#   API_ORIGIN=http://localhost:8080


# ══ Deployment — GitHub, not this file ═══════════════════════════════════════
#
# Nothing below is read from here. Set them in GitHub so the deploy workflow
# can reach your server. See docs/deploy.md for how to obtain each one.
#
#   [GH SECRET]  TS_OAUTH_CLIENT_ID   Tailscale OAuth client id
#   [GH SECRET]  TS_OAUTH_SECRET      Tailscale OAuth client secret
#   [GH SECRET]  DEPLOY_SSH_KEY       private key authorised on the server,
#                                     the whole file including BEGIN/END lines
#
#   [GH VAR]     DEPLOY_HOST          server's tailnet address, e.g. 100.86.149.92
#                                     A GitHub runner has no route to your LAN,
#                                     so a 192.168.x.x address will not work.
#   [GH VAR]     DEPLOY_USER          ssh user, e.g. deploy
#   [GH VAR]     DEPLOY_PATH          optional, default apps/memorisepdf
#   [GH VAR]     DEPLOY_PORT          optional, default 8080. Host port the API
#                                     binds, on localhost only.
#
# GITHUB_TOKEN is provided by Actions automatically — do not create it.
