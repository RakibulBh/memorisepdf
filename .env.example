# Copy to .env for local development. On the server this file lives at
# ~/apps/unmemorize/data/.env — see docs/deploy.md.

# ── Core ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# Where the API is reachable. Google redirects back to APP_URL, so in
# production this must be the public HTTPS address.
APP_URL=http://localhost:8080

# Where the frontend is reachable. Used for CORS and for post-sign-in redirects.
WEB_URL=http://localhost:3000

# Uploaded lecture files and the log go here.
DATA_DIR=./data

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://unmemorize:unmemorize@localhost:5432/unmemorize?sslmode=disable

# Only read by docker compose, to create the database user on the server.
# Keep it alphanumeric: it is substituted into DATABASE_URL, where a #, @ or /
# would be read as part of the URL rather than the password.
POSTGRES_PASSWORD=change-me

# ── Google sign-in ─────────────────────────────────────────────────────────
# From console.cloud.google.com → APIs & Services → Credentials.
# The authorised redirect URI must be exactly APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_TTL=720h
# Leave unset in production, where it defaults to true for ENV != development.
# SESSION_SECURE=false

# ── Gemini ─────────────────────────────────────────────────────────────────
# From aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_TIMEOUT=3m

# ── Text extraction ────────────────────────────────────────────────────────
TIKA_URL=http://localhost:9998
TIKA_TIMEOUT=2m

# ── Limits (open signup, so these matter) ──────────────────────────────────
MAX_FILE_SIZE=104857600
USER_STORAGE_QUOTA=524288000
MAX_FILES_PER_MODULE=50
GENERATE_RATE_LIMIT=20
MAX_EXTRACTED_CHARS=400000

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=app.log
